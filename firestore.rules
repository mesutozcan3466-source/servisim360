rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── YARDIMCI FONKSİYONLAR ──────────────────────────────────────
    function girisYapilmis() {
      return request.auth != null;
    }

    function kullaniciFirmaId() {
      return get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.firmaId;
    }

    function kullaniciRol() {
      return get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.rol;
    }

    function superAdminMi() {
      return girisYapilmis() &&
        get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.rol == 'superAdmin';
    }

    function firmaAdminMi(firmaId) {
      return girisYapilmis() &&
        kullaniciRol() == 'firmaAdmin' &&
        kullaniciFirmaId() == firmaId;
    }

    function soforMu(firmaId) {
      return girisYapilmis() &&
        kullaniciRol() == 'sofor' &&
        kullaniciFirmaId() == firmaId;
    }

    function veliMi(firmaId) {
      return girisYapilmis() &&
        kullaniciRol() == 'veli' &&
        kullaniciFirmaId() == firmaId;
    }

    function personelMi(firmaId) {
      return girisYapilmis() &&
        (kullaniciRol() == 'sekreter' || kullaniciRol() == 'personel') &&
        kullaniciFirmaId() == firmaId;
    }

    function firmaErisimi(firmaId) {
      return superAdminMi() ||
        firmaAdminMi(firmaId) ||
        soforMu(firmaId) ||
        personelMi(firmaId);
    }

    // ── KULLANICILAR ────────────────────────────────────────────────
    match /kullanicilar/{uid} {
      allow read: if girisYapilmis() && (
        request.auth.uid == uid || superAdminMi()
      );
      allow write: if girisYapilmis() && (
        request.auth.uid == uid || superAdminMi() ||
        firmaAdminMi(resource.data.firmaId)
      );
      allow create: if girisYapilmis();
    }

    // ── FİRMALAR ────────────────────────────────────────────────────
    match /firms/{firmaId} {
      allow read: if girisYapilmis() && (
        superAdminMi() || kullaniciFirmaId() == firmaId
      );
      allow write: if superAdminMi() || firmaAdminMi(firmaId);
      allow create: if girisYapilmis();

      // Alt koleksiyonlar
      match /ayarlar/{doc} {
        allow read: if girisYapilmis() && kullaniciFirmaId() == firmaId;
        allow write: if firmaAdminMi(firmaId) || superAdminMi();
      }
    }

    // ── PROJELERr ────────────────────────────────────────────────────
    match /projects/{projeId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        kullaniciFirmaId() == resource.data.firmaId
      );
      allow write: if superAdminMi() ||
        firmaAdminMi(resource.data.firmaId);
      allow create: if firmaAdminMi(request.resource.data.firmaId) || superAdminMi();
    }

    // ── ÖĞRENCİLER ──────────────────────────────────────────────────
    match /students/{ogrenciId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        firmaErisimi(resource.data.firmaId) ||
        // Veli sadece kendi çocuğunu görebilir
        (veliMi(resource.data.firmaId) &&
          (resource.data.veliId == request.auth.uid ||
           resource.data.veliEmail == request.auth.token.email))
      );
      allow write: if superAdminMi() ||
        firmaAdminMi(resource.data.firmaId) ||
        soforMu(resource.data.firmaId) ||
        personelMi(resource.data.firmaId);
      allow create: if girisYapilmis() && (
        superAdminMi() ||
        firmaAdminMi(request.resource.data.firmaId) ||
        personelMi(request.resource.data.firmaId)
      );
      allow update: if girisYapilmis() && (
        superAdminMi() ||
        firmaAdminMi(resource.data.firmaId) ||
        soforMu(resource.data.firmaId) ||
        // Veli sadece bindi alanını güncelleyemez
        (veliMi(resource.data.firmaId) && false)
      );
    }

    // ── ŞOFÖRLER / SÜRÜCÜLER ────────────────────────────────────────
    match /drivers/{surucuId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        kullaniciFirmaId() == resource.data.firmaId
      );
      allow write: if superAdminMi() ||
        firmaAdminMi(resource.data.firmaId);
      allow create: if firmaAdminMi(request.resource.data.firmaId) || superAdminMi();
      // Şoför kendi dokümanını güncelleyebilir (konum, servisAktif)
      allow update: if girisYapilmis() && (
        superAdminMi() ||
        firmaAdminMi(resource.data.firmaId) ||
        (soforMu(resource.data.firmaId) &&
          request.auth.uid == resource.data.uid)
      );
    }

    // ── VELİLER ─────────────────────────────────────────────────────
    match /parents/{veliId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        firmaAdminMi(resource.data.firmaId) ||
        personelMi(resource.data.firmaId) ||
        request.auth.uid == resource.data.uid
      );
      allow write: if superAdminMi() ||
        firmaAdminMi(resource.data.firmaId) ||
        personelMi(resource.data.firmaId);
      allow create: if girisYapilmis();
      allow update: if girisYapilmis() && (
        superAdminMi() ||
        firmaAdminMi(resource.data.firmaId) ||
        request.auth.uid == resource.data.uid
      );
    }

    // ── BİLDİRİMLER ─────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        resource.data.aliciId == request.auth.uid ||
        firmaAdminMi(resource.data.firmaId)
      );
      allow create: if girisYapilmis();
      allow update: if girisYapilmis() && (
        resource.data.aliciId == request.auth.uid ||
        firmaAdminMi(resource.data.firmaId)
      );
      allow delete: if superAdminMi() || firmaAdminMi(resource.data.firmaId);
    }

    // ── DEVAMSIZLIK İSTEKLERİ ────────────────────────────────────────
    match /absence_requests/{istekId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        firmaErisimi(resource.data.firmaId) ||
        resource.data.veliId == request.auth.uid
      );
      allow create: if girisYapilmis();
      allow update: if superAdminMi() ||
        firmaAdminMi(resource.data.firmaId) ||
        soforMu(resource.data.firmaId);
      allow delete: if superAdminMi() || firmaAdminMi(resource.data.firmaId);
    }

    // ── FİYATLAR ─────────────────────────────────────────────────────
    match /fiyatlar/{fiyatId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        kullaniciFirmaId() == resource.data.firmaId
      );
      allow write: if superAdminMi() || firmaAdminMi(resource.data.firmaId);
      allow create: if firmaAdminMi(request.resource.data.firmaId) || superAdminMi();
    }

    // ── HAZIR MESAJLAR ───────────────────────────────────────────────
    match /hazir_mesajlar/{mesajId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        kullaniciFirmaId() == resource.data.firmaId
      );
      allow write: if superAdminMi() || firmaAdminMi(resource.data.firmaId);
    }

    // ── KAYIT LİNKLERİ ───────────────────────────────────────────────
    match /kayit_linkleri/{linkId} {
      allow read: if true; // Anonim kullanıcılar da okuyabilir (kayıt için)
      allow write: if girisYapilmis() && (
        superAdminMi() || firmaAdminMi(resource.data.firmaId)
      );
      allow create: if girisYapilmis() && (
        superAdminMi() || firmaAdminMi(request.resource.data.firmaId)
      );
    }

    // ── GÜZERGAH KAYITLARI ───────────────────────────────────────────
    match /guzergah_kayitlar/{kayitId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        firmaAdminMi(resource.data.firmaId) ||
        (soforMu(resource.data.firmaId) &&
          resource.data.surucuId == request.auth.uid)
      );
      allow create: if girisYapilmis() && soforMu(request.resource.data.firmaId);
      allow delete: if superAdminMi() || firmaAdminMi(resource.data.firmaId);
    }

    // ── ARAÇLAR ──────────────────────────────────────────────────────
    match /vehicles/{aracId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        kullaniciFirmaId() == resource.data.firmaId
      );
      allow write: if superAdminMi() || firmaAdminMi(resource.data.firmaId);
    }

    // ── SÖZLEŞMELER ──────────────────────────────────────────────────
    match /sozlesmeler/{sozlesmeId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        firmaAdminMi(resource.data.firmaId) ||
        resource.data.veliId == request.auth.uid
      );
      allow create: if girisYapilmis();
      allow update: if girisYapilmis() && (
        superAdminMi() ||
        firmaAdminMi(resource.data.firmaId) ||
        resource.data.veliId == request.auth.uid
      );
    }

    // ── LİSANSLAR ────────────────────────────────────────────────────
    match /licenses/{lisansId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        kullaniciFirmaId() == resource.data.firmaId
      );
      allow write: if superAdminMi();
    }

    // ── PERSONEL ─────────────────────────────────────────────────────
    match /staff_members/{personelId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        kullaniciFirmaId() == resource.data.firmaId
      );
      allow write: if superAdminMi() || firmaAdminMi(resource.data.firmaId);
    }

    // ── ROTALAR ──────────────────────────────────────────────────────
    match /routes/{rotaId} {
      allow read: if girisYapilmis() && (
        superAdminMi() ||
        kullaniciFirmaId() == resource.data.firmaId
      );
      allow write: if superAdminMi() ||
        firmaAdminMi(resource.data.firmaId) ||
        soforMu(resource.data.firmaId);
    }

    // ── SUPER ADMIN: DESTEK LOGLARI ──────────────────────────────────
    match /supportLogs/{logId} {
      allow read: if superAdminMi();
      allow create: if girisYapilmis();
    }

    // ── SUPER ADMIN: TÜM FİRMALAR (eski koleksiyon) ─────────────────
    match /firmalar/{firmaId} {
      allow read: if superAdminMi() || kullaniciFirmaId() == firmaId;
      allow write: if superAdminMi();
    }

  }
}
