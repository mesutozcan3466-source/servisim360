rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function girisYapti() {
      return request.auth != null;
    }

    function kendi(uid) {
      return request.auth.uid == uid;
    }

    function adminMi() {
      return get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.rol == 'admin'
          || get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.rol == 'superadmin';
    }

    match /companies/{companyId} {
      allow read: if true;
      allow write: if girisYapti() && adminMi();
    }

    match /companies/{companyId}/{subcollection=**} {
      allow read: if girisYapti();
      allow write: if girisYapti();
    }

    // ✅ YENİ - 360 mimarisi
    match /firmalar/{firmaId} {
      allow read  : if girisYapti();
      allow write : if girisYapti() && adminMi();
    }

    match /firmalar/{firmaId}/{subcollection=**} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /kullanicilar/{uid} {
      allow read  : if girisYapti() && (kendi(uid) || adminMi());
      allow create: if girisYapti();
      allow update: if girisYapti() && (kendi(uid) || adminMi());
      allow delete: if adminMi();
    }

    match /firma_ayarlari/{uid} {
      allow read  : if girisYapti() && kendi(uid);
      allow write : if girisYapti() && kendi(uid);
    }

    match /ogrenciler/{id} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /suruculer/{id} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /servisler/{id} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /surucu_konumlar/{uid} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /surucu_guzergah_kayitlari/{id} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /veli_kayitlari/{id} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /yokluklar/{id} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /duraklar/{id} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /projeler/{id} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /rotalar/{id} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /guzergahlar/{id} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }

    match /veli_basvurulari/{id} {
      allow read  : if girisYapti();
      allow create: if true;
      allow update: if girisYapti();
      allow delete: if girisYapti();
    }

    match /degisiklik_gecmisi/{id} {
      allow read  : if girisYapti();
      allow write : if girisYapti();
    }
  }
}
