rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Giriş yapmış herkes okuyabilir
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024; // max 10MB
    }

    // Profil fotoğrafları
    match /profil/{uid}/{fileName} {
      allow read : if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Evraklar (ehliyet, sigorta, sözleşme PDF vb.)
    match /evraklar/{firmaId}/{kategori}/{fileName} {
      allow read : if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024; // max 20MB
    }

    // Öğrenci fotoğrafları
    match /ogrenciler/{firmaId}/{ogrenciId}/{fileName} {
      allow read : if request.auth != null;
      allow write: if request.auth != null;
    }

    // Şoför fotoğrafları & belgeleri
    match /soforler/{firmaId}/{soforId}/{fileName} {
      allow read : if request.auth != null;
      allow write: if request.auth != null;
    }

    // QR & Afiş görselleri
    match /afisler/{firmaId}/{fileName} {
      allow read : if true;
      allow write: if request.auth != null;
    }

    // PDF sözleşmeler
    match /sozlesmeler/{firmaId}/{fileName} {
      allow read : if request.auth != null;
      allow write: if request.auth != null;
    }

    // Firma logosu
    match /firma_logo/{firmaId}/{fileName} {
      allow read : if true;
      allow write: if request.auth != null;
    }
  }
}
